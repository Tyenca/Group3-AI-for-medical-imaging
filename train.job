#!/bin/bash
# Train one configuration with one seed, then compute its 3D metrics.
#
#   sbatch -J base_s1   train.job baseline 1
#   sbatch -J prep_s1   train.job zscore   1 oversample
#   sbatch -J dicece_s1 train.job baseline 1 uniform dicece
#
# Arguments: <variant> <seed> [sampling] [loss]
#   variant  which sliced directory to train on (see slice.job)
#   seed     1, 2 or 3. Always run all three: a single run is not evidence.
#   sampling uniform (default) or oversample
#   loss     ce (default), wce, focal or dicece
#
# Results land in results/<variant>[_oversample][_<loss>]_seed<seed>/, so every run is
# self identifying and runs never overwrite each other.

#SBATCH --job-name=ai4mi_train
#SBATCH --account=gpuuva084
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=9
#SBATCH --time=04:00:00
#SBATCH --output=slurm_logs/%x_%j.out
#SBATCH --error=slurm_logs/%x_%j.err

set -e

EPOCHS=50

mkdir -p slurm_logs

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ai4mi_venv/bin/activate

cd "${SLURM_SUBMIT_DIR:-$HOME/Group3-AI-for-medical-imaging}"

VARIANT="${1:?Usage: sbatch train.job <variant> <seed> [uniform|oversample] [loss]}"
SEED="${2:?Usage: sbatch train.job <variant> <seed> [uniform|oversample] [loss]}"
SAMPLING="${3:-uniform}"
LOSS="${4:-ce}"

case "${VARIANT}" in
    baseline|zscore|zscore_skip) ;;
    *)
        echo "ERROR: unknown variant '${VARIANT}'. Use baseline, zscore or zscore_skip." >&2
        exit 1
        ;;
esac

case "${SAMPLING}" in
    uniform|oversample) ;;
    *)
        echo "ERROR: sampling must be uniform or oversample, got '${SAMPLING}'." >&2
        exit 1
        ;;
esac

case "${LOSS}" in
    ce|wce|focal|dicece) ;;
    *)
        echo "ERROR: loss must be ce, wce, focal or dicece, got '${LOSS}'." >&2
        exit 1
        ;;
esac
AUGMENT="${5:-noaug}"

case "${AUGMENT}" in
    noaug) AUG_FLAG="" ;;
    aug)   AUG_FLAG="--augment" ;;
    *) echo "ERROR: augment must be noaug or aug, got '${AUGMENT}'." >&2; exit 1 ;;
esac


SLICE_DIR="data/SEGTHOR_${VARIANT}"

if [ "${SAMPLING}" = "oversample" ]; then
    RESULT_DIR="results/${VARIANT}_oversample"
else
    RESULT_DIR="results/${VARIANT}"
fi
[ "${LOSS}" != ce ] && RESULT_DIR="${RESULT_DIR}_${LOSS}"
[ "${AUGMENT}" = aug ] && RESULT_DIR="${RESULT_DIR}_aug"
RESULT_DIR="${RESULT_DIR}_seed${SEED}"

echo "=== Job $SLURM_JOB_ID: ${VARIANT}, sampling=${SAMPLING}, loss=${LOSS}, seed ${SEED}, $(date) ==="
echo "Node: $SLURMD_NODENAME"
nvidia-smi

if [ ! -d "${SLICE_DIR}/train/img" ]; then
    echo "ERROR: ${SLICE_DIR} not found. Run 'sbatch slice.job ${VARIANT}' first." >&2
    exit 1
fi

# Oversampling needs the empty slices to still be there to down-weight them.
if [ "${SAMPLING}" = "oversample" ] && [ "${VARIANT}" = "zscore_skip" ]; then
    echo "ERROR: zscore_skip already removed the empty slices, so there is" >&2
    echo "       nothing for oversampling to down-weight. Use the zscore variant." >&2
    exit 1
fi

mkdir -p "${RESULT_DIR}"
{
    echo "variant:      ${VARIANT}"
    echo "sampling:     ${SAMPLING}"
    echo "seed:         ${SEED}"
    echo "loss:         ${LOSS}"
    echo "slice_dir:    ${SLICE_DIR}"
    echo "epochs:       ${EPOCHS}"
    echo "train_slices: $(ls ${SLICE_DIR}/train/img | wc -l)"
    echo "val_slices:   $(ls ${SLICE_DIR}/val/img | wc -l)"
    echo "git_commit:   $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "slurm_job:    ${SLURM_JOB_ID}"
    echo "started:      $(date)"
} > "${RESULT_DIR}/run_config.txt"
cat "${RESULT_DIR}/run_config.txt"

echo ">>> Training ${EPOCHS} epochs on ${SLICE_DIR} -> ${RESULT_DIR}"
python -u main.py \
    --dataset SEGTHOR \
    --data_dir "${SLICE_DIR}" \
    --mode full \
    --epochs ${EPOCHS} \
    --dest "${RESULT_DIR}" \
    --seed "${SEED}" \
    --sampling "${SAMPLING}" \
    --loss "${LOSS}" \
    ${AUG_FLAG} \
    --track_co2 \
    --gpu

echo ">>> Computing 3D metrics"
python -u metrics_3d.py \
    --pred-dir "${RESULT_DIR}/best_epoch/val" \
    --gt-dir "${SLICE_DIR}/val/gt" \
    --spacing-pkl "${SLICE_DIR}/spacing.pkl" \
    --out-dir "${RESULT_DIR}/metrics"

echo "=== Job $SLURM_JOB_ID finished at $(date) ==="