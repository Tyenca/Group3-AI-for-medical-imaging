#!/bin/bash
# Train the 3D U-Net with one seed, then compute its 3D metrics.
#
#   sbatch -J 3d_s1     train3d.job zscore 1
#   sbatch -J 3d_aug_s1 train3d.job zscore 1 ce aug
#
# Arguments: <variant> <seed> [loss] [augment] [kernels] [epochs]
#   variant  which sliced directory to use (zscore, as the 2D runs)
#   seed     1, 2 or 3. Always run all three: a single run is not evidence.
#   loss     ce (default) or dicece
#   augment  noaug (default) or aug (in plane affine, same for every slice)
#   kernels  base channel width of the 3D U-Net, 16 (default)
#   epochs   100 (default); one epoch = 250 patches of 48x128x128
#
# Results land in results/<variant>_3d[_<loss>][_k<N>][_aug]_seed<seed>/, with
# predictions saved as 2D PNG slices so metrics_3d.py works as for 2D runs.

#SBATCH --job-name=ai4mi_3d
#SBATCH --account=gpuuva084
#SBATCH --partition=gpu_a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=9
#SBATCH --time=04:00:00
#SBATCH --output=slurm_logs/%x_%j.out
#SBATCH --error=slurm_logs/%x_%j.err

set -e

mkdir -p slurm_logs

module purge
module load 2023
module load Python/3.11.3-GCCcore-12.3.0

source $HOME/ai4mi_venv/bin/activate

cd "${SLURM_SUBMIT_DIR:-$HOME/Group3-AI-for-medical-imaging}"

VARIANT="${1:?Usage: sbatch train3d.job <variant> <seed> [loss] [augment] [kernels] [epochs]}"
SEED="${2:?Usage: sbatch train3d.job <variant> <seed> [loss] [augment] [kernels] [epochs]}"
LOSS="${3:-ce}"
AUGMENT="${4:-noaug}"
KERNELS="${5:-16}"
EPOCHS="${6:-100}"

case "${LOSS}" in
    ce|dicece) ;;
    *) echo "ERROR: loss must be ce or dicece, got '${LOSS}'." >&2; exit 1 ;;
esac
case "${AUGMENT}" in
    noaug) AUG_FLAG="" ;;
    aug)   AUG_FLAG="--augment" ;;
    *) echo "ERROR: augment must be noaug or aug, got '${AUGMENT}'." >&2; exit 1 ;;
esac

SLICE_DIR="data/SEGTHOR_${VARIANT}"
RESULT_DIR="results/${VARIANT}_3d"
[ "${LOSS}" != ce ] && RESULT_DIR="${RESULT_DIR}_${LOSS}"
[ "${KERNELS}" != 16 ] && RESULT_DIR="${RESULT_DIR}_k${KERNELS}"
[ "${AUGMENT}" = aug ] && RESULT_DIR="${RESULT_DIR}_aug"
RESULT_DIR="${RESULT_DIR}_seed${SEED}"

echo "=== Job $SLURM_JOB_ID: 3D ${VARIANT}, loss=${LOSS}, ${AUGMENT}, seed ${SEED}, $(date) ==="
echo "Node: $SLURMD_NODENAME"
nvidia-smi

if [ ! -d "${SLICE_DIR}/train/img" ]; then
    echo "ERROR: ${SLICE_DIR} not found." >&2
    exit 1
fi

mkdir -p "${RESULT_DIR}"
{
    echo "variant:      ${VARIANT}"
    echo "network:      unet3d"
    echo "seed:         ${SEED}"
    echo "loss:         ${LOSS}"
    echo "augment:      ${AUGMENT}"
    echo "kernels:      ${KERNELS}"
    echo "patch:        48 128 128"
    echo "epochs:       ${EPOCHS}"
    echo "slice_dir:    ${SLICE_DIR}"
    echo "train_slices: $(ls ${SLICE_DIR}/train/img | wc -l)"
    echo "val_slices:   $(ls ${SLICE_DIR}/val/img | wc -l)"
    echo "git_commit:   $(git rev-parse --short HEAD 2>/dev/null || echo unknown)"
    echo "slurm_job:    ${SLURM_JOB_ID}"
    echo "started:      $(date)"
} > "${RESULT_DIR}/run_config.txt"
cat "${RESULT_DIR}/run_config.txt"

echo ">>> Training 3D U-Net for ${EPOCHS} epochs on ${SLICE_DIR} -> ${RESULT_DIR}"
python -u main3d.py \
    --data_dir "${SLICE_DIR}" \
    --dest "${RESULT_DIR}" \
    --epochs "${EPOCHS}" \
    --seed "${SEED}" \
    --loss "${LOSS}" \
    ${AUG_FLAG} \
    --kernels "${KERNELS}" \
    --track_co2 \
    --gpu

echo ">>> Computing 3D metrics"
python -u metrics_3d.py \
    --pred-dir "${RESULT_DIR}/best_epoch/val" \
    --gt-dir "${SLICE_DIR}/val/gt" \
    --spacing-pkl "${SLICE_DIR}/spacing.pkl" \
    --out-dir "${RESULT_DIR}/metrics"

echo "=== Job $SLURM_JOB_ID finished at $(date) ==="
